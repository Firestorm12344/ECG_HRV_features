summary_table = (
    df_all
    .groupby(["dataset", "class"])[features_plot]
    .agg(["mean", "std", "count"])
)

print(summary_table)
summary_table.to_csv("Results/comparison/mean_sd_summary.csv")

# ============================================================
# PLOTS: MEAN ± SD
# ============================================================

for feature in features_plot:
    summary = (
        df_all
        .groupby(["class", "dataset"])[feature]
        .agg(["mean", "std"])
        .reset_index()
    )

    x = np.arange(len(class_order))
    width = 0.35

    plt.figure(figsize=(7, 4))

    for i, ds in enumerate(dataset_order):
        vals = []
        errs = []

        for cls in class_order:
            row = summary[
                (summary["class"] == cls) &
                (summary["dataset"] == ds)
            ]

            if row.empty:
                vals.append(np.nan)
                errs.append(0)
            else:
                vals.append(row["mean"].values[0])
                errs.append(row["std"].values[0])

        offset = (i - 0.5) * width

        plt.bar(
            x + offset,
            vals,
            width,
            yerr=errs,
            capsize=4,
            label=ds
        )

    plt.xticks(x, class_order)
    plt.xlabel("Rhythm class")
    plt.ylabel(feature)
    plt.title(f"{feature} mean ± SD")
    plt.legend(title="Dataset")
    plt.grid(axis="y", alpha=0.3)
    plt.tight_layout()

    save_path = os.path.join(results_dir, f"{feature}_mean_sd.png")
    plt.savefig(save_path, dpi=300)
    plt.close()

    print("Saved:", save_path)

print("\nDone.")
