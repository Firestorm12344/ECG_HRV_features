# ============================================================
# CONFIG
# ============================================================

processed_dir = "Processed_Data"
results_dir = "Results/comparison/figures_mean_sd"

fs = 500
lead_index = 1

features_plot = ["RR_mean", "SDRR", "RMSSD"]
class_order = ["SR", "AF", "ST", "SB"]
dataset_order = ["D1", "D2"]

os.makedirs(results_dir, exist_ok=True)

# ============================================================
# DETECTOR
# ============================================================

def detect_r_threshold(ecg, fs=500):
    ecg = preprocess_ecg_for_hrv(
        ecg,
        use_wavelet=True,
        normalize=True
    )

    upper_threshold = 0.60
    lower_threshold = 0.45

    ignore_reading = False
    peaks = []

    for i, value in enumerate(ecg):
        if value >= upper_threshold and not ignore_reading:
            peaks.append(i)
            ignore_reading = True

        if value < lower_threshold:
            ignore_reading = False

    min_distance = int(0.25 * fs)

    filtered_peaks = []
    last_peak = -999999

    for p in peaks:
        if p - last_peak >= min_distance:
            filtered_peaks.append(p)
            last_peak = p

    return np.array(filtered_peaks, dtype=int)

# ============================================================
# HRV
# ============================================================

def compute_hrv(ecg, fs=500):
    peaks = detect_r_threshold(ecg, fs=fs)

    if len(peaks) < 2:
        return [np.nan, np.nan, np.nan]

    rr = np.diff(peaks) / fs
    rr = rr[(rr > 0.30) & (rr < 2.50)]

    if len(rr) < 1:
        return [np.nan, np.nan, np.nan]

    rr_diff = np.abs(np.diff(rr))

    rr_mean = np.mean(rr)
    sdrr = np.std(rr, ddof=1) if len(rr) > 1 else 0.0
    rmssd = np.sqrt(np.mean(rr_diff ** 2)) if len(rr_diff) > 0 else 0.0

    return [rr_mean, sdrr, rmssd]

# ============================================================
# BUILD DATAFRAME
# ============================================================

def build_df(dataset_id, dataset_name):
    X, y = load_dataset_all(
        processed_dir=processed_dir,
        dataset=dataset_id
    )

    rows = []

    for idx in range(len(X)):
        ecg = X[idx, :, lead_index]
        rrmean, sdrr, rmssd = compute_hrv(ecg, fs=fs)

        rows.append({
            "dataset": dataset_name,
            "label": int(y[idx]),
            "class": CLASS_NAMES[int(y[idx])],
            "RR_mean": rrmean,
            "SDRR": sdrr,
            "RMSSD": rmssd,
        })

    return pd.DataFrame(rows)

